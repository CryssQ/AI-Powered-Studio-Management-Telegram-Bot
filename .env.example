# GEMINI_API: Alternative secret name for Gemini AI API calls.
GEMINI_API="MY_GEMINI_API"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback to avoid Gemini quota limits.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""

# EMAIL_HOST: SMTP host for sending order notifications.
EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT: SMTP port (usually 587 or 465).
EMAIL_PORT="587"
# EMAIL_USER: Email address to send from.
EMAIL_USER=""
# EMAIL_PASS: App password for the sender email.
EMAIL_PASS=""
# EMAIL_RECEIVER: Email address to receive notifications about new orders.
EMAIL_RECEIVER=""
